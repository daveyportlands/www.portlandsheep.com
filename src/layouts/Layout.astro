---
export interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Portland Sheep Breeders\' Group — the most popular rare breed for smallholders.' } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title} | Portland Sheep Breeders' Group</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <script src="https://identity.netlify.com/v1/netlify-identity-widget.js" is:inline></script>
</head>
<body class="bg-cream-50 text-gray-800 font-sans">

  <!-- Top bar -->
  <div class="bg-sage-800 text-cream-200 text-sm py-2 px-4 text-center">
    <a href="mailto:portland.sheep.enquiries@gmail.com" class="hover:text-white transition-colors">
      portland.sheep.enquiries@gmail.com
    </a>
    <span class="mx-3 opacity-40">|</span>
    <a href="https://instagram.com/portlandsheepbreeders" target="_blank" rel="noopener" class="hover:text-white transition-colors">Instagram</a>
    <span class="mx-3 opacity-40">|</span>
    <a href="https://facebook.com" target="_blank" rel="noopener" class="hover:text-white transition-colors">Facebook</a>
  </div>

  <!-- Header -->
  <header class="bg-white border-b border-cream-300 sticky top-0 z-50 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-20">
        <!-- Logo / Brand -->
        <a href="/" class="flex items-center gap-3 group">
          <img src="/images/logo.png" alt="Portland Sheep Breeders' Group" class="w-14 h-14 object-contain flex-shrink-0" />
          <div class="hidden sm:block">
            <div class="font-serif font-semibold text-sage-800 text-lg leading-tight">Portland Sheep</div>
            <div class="text-xs text-sage-500 tracking-wide uppercase">Breeders' Group</div>
          </div>
        </a>

        <!-- Desktop nav -->
        <nav class="hidden lg:flex items-center gap-1 text-sm font-medium">
          <a href="/" class="nav-link">Home</a>

          <div class="relative group">
            <button class="nav-link flex items-center gap-1">
              About
              <svg class="w-3 h-3 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </button>
            <div class="dropdown">
              <a href="/about/" class="dropdown-item">About Portland Sheep</a>
              <a href="/about/why-portland-sheep/" class="dropdown-item">Why Choose Portlands?</a>
              <a href="/about/history/" class="dropdown-item">History</a>
              <a href="/about/wool/" class="dropdown-item">Wool</a>
              <a href="/about/for-the-table/" class="dropdown-item">For the Table</a>
            </div>
          </div>

          <div class="relative group">
            <button class="nav-link flex items-center gap-1">
              Husbandry
              <svg class="w-3 h-3 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </button>
            <div class="dropdown">
              <a href="/husbandry/" class="dropdown-item">Husbandry Overview</a>
              <a href="/husbandry/shepherds-year/" class="dropdown-item">Shepherd's Year</a>
              <a href="/husbandry/lambing/" class="dropdown-item">Lambing</a>
              <a href="/husbandry/health/" class="dropdown-item">Health Tasks</a>
              <a href="/husbandry/tupping/" class="dropdown-item">Tupping</a>
              <a href="/husbandry/rules-and-regulations/" class="dropdown-item">Rules & Regulations</a>
            </div>
          </div>

          <a href="/showing/" class="nav-link">Showing</a>
          <a href="/marketplace/" class="nav-link">Marketplace</a>
          <a href="/gallery/" class="nav-link">Gallery</a>
          <a href="/membership/" class="nav-link">Membership</a>
          <a href="/contact/" class="nav-link">Contact</a>

          <a href="/members/" class="ml-3 inline-flex items-center gap-1.5 bg-sage-700 hover:bg-sage-600 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
            Members
          </a>
        </nav>

        <!-- Mobile hamburger -->
        <button id="mobile-menu-btn" class="lg:hidden p-2 rounded-md text-sage-700 hover:bg-cream-100 transition-colors" aria-label="Open menu">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path id="hamburger-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile menu -->
    <div id="mobile-menu" class="hidden lg:hidden border-t border-cream-200 bg-white">
      <div class="px-4 py-4 space-y-1">
        <a href="/" class="mobile-nav-link">Home</a>
        <a href="/about/" class="mobile-nav-link">About Portland Sheep</a>
        <a href="/about/why-portland-sheep/" class="mobile-nav-link pl-6 text-sm">Why Choose Portlands?</a>
        <a href="/husbandry/" class="mobile-nav-link">Husbandry Overview</a>
        <a href="/husbandry/shepherds-year/" class="mobile-nav-link pl-6 text-sm">Shepherd's Year</a>
        <a href="/husbandry/lambing/" class="mobile-nav-link pl-6 text-sm">Lambing</a>
        <a href="/husbandry/health/" class="mobile-nav-link pl-6 text-sm">Health Tasks</a>
        <a href="/husbandry/tupping/" class="mobile-nav-link pl-6 text-sm">Tupping</a>
        <a href="/husbandry/rules-and-regulations/" class="mobile-nav-link pl-6 text-sm">Rules & Regulations</a>
        <a href="/showing/" class="mobile-nav-link">Showing</a>
        <a href="/marketplace/" class="mobile-nav-link">Marketplace</a>
        <a href="/gallery/" class="mobile-nav-link">Gallery</a>
        <a href="/membership/" class="mobile-nav-link">Membership</a>
        <a href="/contact/" class="mobile-nav-link">Contact</a>
        <a href="/members/" class="mobile-nav-link font-semibold text-sage-700">🔒 Members Area</a>
      </div>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <!-- Footer -->
  <footer class="bg-sage-900 text-cream-200 mt-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
        <div>
          <h3 class="font-serif text-xl text-white mb-4">Portland Sheep Breeders' Group</h3>
          <p class="text-sm leading-relaxed text-cream-300 mb-6">
            Supporting breeders and enthusiasts of the Portland sheep — the most popular rare breed for smallholders.
          </p>
          <div class="flex gap-4">
            <a href="https://instagram.com/portlandsheepbreeders" target="_blank" rel="noopener" class="footer-social-link">IG</a>
            <a href="https://facebook.com" target="_blank" rel="noopener" class="footer-social-link">FB</a>
          </div>
        </div>
        <div>
          <h4 class="text-sm font-semibold uppercase tracking-wider text-cream-300 mb-4">Quick Links</h4>
          <ul class="space-y-2 text-sm">
            <li><a href="/about/" class="footer-link">About Portland Sheep</a></li>
            <li><a href="/husbandry/" class="footer-link">Husbandry & Management</a></li>
            <li><a href="/showing/" class="footer-link">Showing Sheep</a></li>
            <li><a href="/marketplace/" class="footer-link">Marketplace</a></li>
            <li><a href="/gallery/" class="footer-link">Gallery</a></li>
            <li><a href="/membership/" class="footer-link">Membership</a></li>
          </ul>
        </div>
        <div>
          <h4 class="text-sm font-semibold uppercase tracking-wider text-cream-300 mb-4">Organisation</h4>
          <ul class="space-y-2 text-sm">
            <li><a href="/committee/" class="footer-link">Committee & Officers</a></li>
            <li><a href="/constitution/" class="footer-link">Constitution</a></li>
            <li><a href="/newsletters/" class="footer-link">Newsletter Archive</a></li>
            <li><a href="/contact/" class="footer-link">Contact Us</a></li>
            <li>
              <a href="/members/" class="footer-link flex items-center gap-1.5">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                Members Area
              </a>
            </li>
          </ul>
          <div class="mt-6 text-sm">
            <p class="text-cream-400">
              <a href="mailto:portland.sheep.enquiries@gmail.com" class="hover:text-white transition-colors">
                portland.sheep.enquiries@gmail.com
              </a>
            </p>
          </div>
        </div>
      </div>
      <div class="border-t border-sage-700 mt-12 pt-8 text-center text-xs text-cream-400">
        <p>&copy; {new Date().getFullYear()} Portland Sheep Breeders' Group. All rights reserved.</p>
      </div>
    </div>
  </footer>

  <script>
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    btn?.addEventListener('click', () => {
      menu?.classList.toggle('hidden');
    });
  </script>

  <script is:inline>
    if (window.netlifyIdentity) {
      window.netlifyIdentity.on('init', user => {
        if (!user) {
          window.netlifyIdentity.on('login', () => {
            document.location.href = '/admin/';
          });
        }
      });
    }
  </script>
</body>
</html>

<style is:global>
  .nav-link {
    @apply px-3 py-2 rounded-md text-gray-700 hover:text-sage-700 hover:bg-cream-100 transition-colors;
  }
  .dropdown {
    @apply absolute top-full left-0 mt-1 w-52 bg-white border border-cream-200 rounded-xl shadow-lg py-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 z-50;
  }
  .dropdown-item {
    @apply block px-4 py-2 text-sm text-gray-700 hover:bg-cream-100 hover:text-sage-700 transition-colors;
  }
  .mobile-nav-link {
    @apply block px-3 py-2 rounded-md text-gray-700 hover:bg-cream-100 hover:text-sage-700 transition-colors;
  }
  .footer-link {
    @apply text-cream-300 hover:text-white transition-colors;
  }
  .footer-social-link {
    @apply w-9 h-9 rounded-full border border-sage-600 flex items-center justify-center text-xs font-semibold text-cream-300 hover:bg-sage-700 hover:text-white transition-colors;
  }
</style>
