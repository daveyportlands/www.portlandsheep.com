---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page Not Found">
  <div class="min-h-[60vh] flex items-center justify-center px-4">
    <div class="text-center">
      <p class="text-7xl font-serif text-sage-200 font-bold mb-4">404</p>
      <h1 class="font-serif text-3xl text-sage-800 mb-4">Page not found</h1>
      <p class="text-gray-500 mb-8">The page you're looking for has wandered off like a Portland sheep.</p>
      <a href="/" class="inline-flex items-center gap-2 bg-sage-700 hover:bg-sage-600 text-white font-semibold px-6 py-3 rounded-xl transition-colors">
        Back to Home
      </a>
    </div>
  </div>
</Layout>
