---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Committee & Officers">
  <div class="bg-sage-800 text-white py-20 px-4">
    <div class="max-w-4xl mx-auto">
      <p class="text-sage-300 text-sm uppercase tracking-widest mb-3">Organisation</p>
      <h1 class="font-serif text-5xl mb-6">Committee &amp; Officers</h1>
      <p class="text-cream-200 text-xl max-w-2xl">The volunteers who run the Portland Sheep Breeders' Group.</p>
    </div>
  </div>

  <div class="max-w-4xl mx-auto px-4 py-16">
    <div class="bg-cream-100 border border-cream-200 rounded-2xl p-6 mb-10 text-sm text-gray-600">
      The Group is run entirely by volunteers who are themselves Portland sheep breeders. The list below reproduces the committee information published on the previous website for 2024/25 and is awaiting confirmation following the next AGM. Please <a href="/contact/" class="text-sage-600 underline">contact us</a> if you need to reach a current officer.
    </div>

    <div class="grid md:grid-cols-2 gap-6 mb-16">
      {[
        { role: 'Chair', name: 'Tim Hurdley', note: '' },
        { role: 'Secretary', name: 'Rachel Hodder', note: '' },
        { role: 'Treasurer', name: 'Jo Stover', note: '' },
        { role: 'Membership Secretary', name: 'Sarah Tricks', note: '' },
        { role: 'Show Secretary', name: 'Sarah Tricks', note: '' },
        { role: 'Newsletter Editor', name: 'Pat Ashton-Smith', note: '' },
        { role: 'Website & Social Media', name: 'Sarah Tricks & Hannah Stott', note: '' },
        { role: 'Kinship Programme', name: 'Penny Gibson', note: '' },
      ].map(officer => (
        <div class="bg-white rounded-2xl border border-cream-200 p-5 flex items-center gap-4">
          <div class="w-10 h-10 bg-sage-100 rounded-full flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5 text-sage-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
          </div>
          <div>
            <p class="text-xs font-semibold uppercase tracking-wider text-sage-500 mb-0.5">{officer.role}</p>
            <p class="font-medium text-gray-700">{officer.name}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="prose prose-slate prose-headings:font-serif prose-headings:text-sage-800 max-w-none">
      <h2>General Committee</h2>
      <p>Hannah Stott, Pat Ashton-Smith, Zoe Fuller and Rob Groves.</p>
      <h2>Honorary Offices</h2>
      <p><strong>Honorary Breed Historian:</strong> Norman Jones<br/><strong>Honorary President:</strong> Jim Gardner</p>
      <h2>Regional Representatives</h2>
      <ul>
        <li><strong>North-West & Ireland:</strong> Hannah Stott</li>
        <li><strong>North-East:</strong> Shaun Smith</li>
        <li><strong>East:</strong> Sue Stennett</li>
        <li><strong>Wales & Borders:</strong> Helen Butler</li>
        <li><strong>Midlands:</strong> Shaun Smith</li>
        <li><strong>South West:</strong> Rachel Hodder</li>
        <li><strong>South Central:</strong> Fiona MacKenzie</li>
        <li><strong>South East & Europe:</strong> Penny Gibson</li>
        <li><strong>Scotland:</strong> Karen Wilson</li>
      </ul>
      <h2>Contact the Committee</h2>
      <p>All general enquiries should be directed to <a href="mailto:portland.sheep.enquiries@gmail.com">portland.sheep.enquiries@gmail.com</a>. The secretary will direct your message to the appropriate officer.</p>
    </div>
  </div>
</Layout>
