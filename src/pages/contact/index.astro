---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Contact Us">

  <div class="bg-sage-800 text-white py-20 px-4">
    <div class="max-w-4xl mx-auto">
      <p class="text-sage-300 text-sm uppercase tracking-widest mb-3">Get in Touch</p>
      <h1 class="font-serif text-5xl mb-6">Contact Us</h1>
      <p class="text-cream-200 text-xl max-w-2xl">We'd love to hear from you — whether you're a new member, an existing breeder, or just curious about Portland sheep.</p>
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-4 py-16 grid md:grid-cols-2 gap-16">

    <!-- Contact info -->
    <div>
      <h2 class="font-serif text-2xl text-sage-800 mb-8">Get in Touch</h2>

      <div class="space-y-6">
        <div class="flex gap-4 items-start">
          <div class="w-10 h-10 bg-sage-100 rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5">
            <svg class="w-5 h-5 text-sage-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          </div>
          <div>
            <p class="font-semibold text-gray-800 mb-1">Email</p>
            <a href="mailto:portland.sheep.enquiries@gmail.com" class="text-sage-600 hover:text-sage-800 transition-colors">
              portland.sheep.enquiries@gmail.com
            </a>
          </div>
        </div>

        <div class="flex gap-4 items-start">
          <div class="w-10 h-10 bg-sage-100 rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5">
            <svg class="w-5 h-5 text-sage-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14"/></svg>
          </div>
          <div>
            <p class="font-semibold text-gray-800 mb-1">Instagram</p>
            <a href="https://instagram.com/portlandsheepbreeders" target="_blank" rel="noopener" class="text-sage-600 hover:text-sage-800 transition-colors">
              @portlandsheepbreeders
            </a>
          </div>
        </div>

        <div class="flex gap-4 items-start">
          <div class="w-10 h-10 bg-sage-100 rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5">
            <svg class="w-5 h-5 text-sage-600" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </div>
          <div>
            <p class="font-semibold text-gray-800 mb-1">Facebook</p>
            <a href="https://facebook.com" target="_blank" rel="noopener" class="text-sage-600 hover:text-sage-800 transition-colors">
              Portland Sheep Breeders' Group
            </a>
          </div>
        </div>
      </div>

      <div class="mt-10 bg-cream-100 rounded-2xl p-6 border border-cream-200">
        <h3 class="font-semibold text-sage-800 mb-2">Membership enquiries</h3>
        <p class="text-sm text-gray-500">For membership, studbook registration or general questions, email us and we'll aim to reply within 3 working days.</p>
      </div>
    </div>

    <div class="bg-white rounded-2xl border border-cream-200 p-8 self-start">
      <h2 class="font-serif text-2xl text-sage-800 mb-4">Send us an email</h2>
      <p class="text-gray-500 leading-relaxed mb-6">The website is hosted as a static service, so enquiries are handled directly by email. Tell us whether your question is about membership, the studbook, buying stock, shows or husbandry and it will be passed to the appropriate volunteer.</p>
      <a href="mailto:portland.sheep.enquiries@gmail.com?subject=Website enquiry"
         class="inline-flex items-center gap-2 bg-sage-700 hover:bg-sage-600 text-white font-semibold px-6 py-3 rounded-xl transition-colors">
        Email the Group
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
      </a>
    </div>

  </div>

</Layout>
