---
import Layout from '../../layouts/Layout.astro';

const images = [
  '51ee6d_0107ee46ac9c4606aaa9248d6e431dfd.jpg',
  '51ee6d_04638d4f32a2472b9941596bb2ebf35a.jpg',
  '51ee6d_0cc383e8742f42dfa9e4127db7e64f67.jpg',
  '51ee6d_2abef5b2e41846dba6b2beb45b1f7488.jpg',
  '51ee6d_46b01630cf9241829c995be7521b0a5e.jpg',
  '51ee6d_7d77c494cfac4b178809ad7b9b4e682b.jpg',
  '51ee6d_9be5ebb07dd54e0b9561709e5753f778.jpg',
  '51ee6d_ca2237a3a5aa4ce0b9ec3ed23dcf14f3.jpg',
  '51ee6d_e31b12f0f7bb410da7854a8b49b29eb7.jpg',
  '51ee6d_ee2fa396baf141edb027b03fb9874db8.jpg',
  '51ee6d_fe0c439b58344f9cabba7b96b62d2fd0.jpg',
];
---
<Layout title="Gallery">
  <div class="bg-sage-800 text-white py-20 px-4">
    <div class="max-w-4xl mx-auto">
      <p class="text-sage-300 text-sm uppercase tracking-widest mb-3">Photos</p>
      <h1 class="font-serif text-5xl mb-6">Gallery</h1>
      <p class="text-cream-200 text-xl max-w-2xl">Portland sheep from flocks across the UK.</p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 py-16">
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
      {images.map((filename) => (
        <a href={`/images/${filename}`} target="_blank" rel="noopener"
           class="group aspect-square rounded-2xl overflow-hidden border border-sage-200 bg-sage-100 block">
          <img
            src={`/images/${filename}`}
            alt="Portland sheep"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
          />
        </a>
      ))}
    </div>
    <p class="text-center text-sm text-gray-400 mt-10">
      To add photos, upload images via the <a href="/admin/" class="text-sage-600 underline hover:text-sage-800">CMS media library</a> and they'll appear here automatically.
    </p>
  </div>
</Layout>
