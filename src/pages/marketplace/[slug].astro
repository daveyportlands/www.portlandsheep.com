---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const listings = await getCollection('marketplace');
  return listings.map(listing => ({
    params: { slug: listing.slug },
    props: { listing },
  }));
}

const { listing } = Astro.props;
const { Content } = await listing.render();
const categoryLabels: Record<string, string> = {
  stock: 'Stock for Sale',
  fleece_wool_textile: 'Fleece, Wool & Textiles',
  merchandise: 'Merchandise',
};
---
<Layout title={listing.data.title}>
  <div class="max-w-3xl mx-auto px-4 py-16">

    <a href="/marketplace/" class="inline-flex items-center gap-1 text-sm text-sage-600 hover:text-sage-800 mb-8 transition-colors">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      Back to Marketplace
    </a>

    <div class="bg-white rounded-2xl border border-cream-200 p-8">
      <div class="flex items-start justify-between gap-4 mb-2">
        <h1 class="font-serif text-3xl text-sage-800">{listing.data.title}</h1>
        {listing.data.price && (
          <span class="text-xl font-bold text-bark-500 whitespace-nowrap">{listing.data.price}</span>
        )}
      </div>

      <div class="flex items-center gap-3 mb-6">
        <span class="text-xs bg-sage-100 text-sage-700 px-3 py-1 rounded-full font-medium">
          {categoryLabels[listing.data.category]}
        </span>
        <span class="text-xs text-gray-400">
          Listed {listing.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
        </span>
      </div>

      {listing.data.image && (
        <img src={listing.data.image} alt={listing.data.title} class="w-full rounded-xl mb-8 object-cover max-h-80" />
      )}

      <div class="prose prose-slate prose-headings:font-serif prose-headings:text-sage-800 max-w-none mb-8">
        <Content />
      </div>

      <div class="border-t border-cream-200 pt-6">
        <h3 class="font-semibold text-sage-800 mb-1">Contact</h3>
        <p class="text-sm text-gray-600 mb-1">{listing.data.contactName}</p>
        <a href={`mailto:${listing.data.contactEmail}`} class="text-sm text-sage-600 hover:text-sage-800 transition-colors">
          {listing.data.contactEmail}
        </a>
      </div>
    </div>

  </div>
</Layout>
