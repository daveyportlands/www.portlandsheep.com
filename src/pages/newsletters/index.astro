---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const newsletters = await getCollection('newsletters');
const sorted = newsletters.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Layout title="Newsletter Archive">
  <div class="bg-sage-800 text-white py-20 px-4">
    <div class="max-w-4xl mx-auto">
      <p class="text-sage-300 text-sm uppercase tracking-widest mb-3">Resources</p>
      <h1 class="font-serif text-5xl mb-6">Newsletter Archive</h1>
      <p class="text-cream-200 text-xl max-w-2xl">Past issues of the Portland Sheep Breeders' Group newsletter.</p>
    </div>
  </div>

  <div class="max-w-4xl mx-auto px-4 py-16">

    <div class="bg-sage-50 border border-sage-200 rounded-2xl p-5 mb-10 flex items-start gap-3">
      <svg class="w-5 h-5 text-sage-600 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <p class="text-sm text-sage-800">Recent newsletters are available in the <a href="/members/" class="underline hover:text-sage-600">Members Area</a>. Older archived issues are available to all below.</p>
    </div>

    {sorted.length === 0 ? (
      <div class="bg-cream-100 rounded-2xl border border-cream-200 p-8 text-center text-gray-500">
        <p>No newsletters have been published yet. Check back soon.</p>
      </div>
    ) : (
      <div class="space-y-4">
        {sorted.map(newsletter => (
          <div class="bg-white rounded-2xl border border-cream-200 p-5 flex items-center gap-4 hover:shadow-sm transition-shadow">
            <div class="w-10 h-10 bg-sage-100 rounded-xl flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-sage-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/></svg>
            </div>
            <div class="flex-1">
              <h3 class="font-medium text-sage-800">{newsletter.data.title}</h3>
              <p class="text-xs text-gray-400">{newsletter.data.date.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' })}</p>
              {newsletter.data.summary && <p class="text-sm text-gray-500 mt-1">{newsletter.data.summary}</p>}
            </div>
            {newsletter.data.pdf && (
              <a href={newsletter.data.pdf} target="_blank" rel="noopener"
                 class="flex-shrink-0 inline-flex items-center gap-1.5 text-sm font-medium text-sage-600 hover:text-sage-800 transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                Download PDF
              </a>
            )}
          </div>
        ))}
      </div>
    )}
  </div>
</Layout>
